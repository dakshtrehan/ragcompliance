# --- Audit sink and hash chain (1.0) ---
# Where records go. Examples:
#   jsonl:///var/log/ragcompliance/audit.jsonl?fsync=1
#   sqlite:////var/lib/ragcompliance/audit.db
#   postgresql://user:password@host:5432/db?table=rag_audit_records
#   s3://bucket/prefix?object_lock_mode=COMPLIANCE&object_lock_days=365
#   supabase://   (uses the Supabase credentials below)
# Empty: Supabase when its credentials are set, otherwise dev mode or no persistence.
RAGCOMPLIANCE_SINK=
# One chain per (workspace, chain id). Set per writer for S3 or Supabase layout 1.
RAGCOMPLIANCE_CHAIN_ID=default
# Optional HMAC key for record_hmac. Keep it OUT of the record store.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAGCOMPLIANCE_CHAIN_HMAC_KEY=
# Retention in days for `ragcompliance purge` / storage.purge_expired(); blank = keep forever
RAGCOMPLIANCE_RETENTION_DAYS=
# drop (count and log) or block when the async queue is full
RAGCOMPLIANCE_ASYNC_OVERFLOW=drop
# Persist an error record when an invocation fails
RAGCOMPLIANCE_RECORD_ERRORS=false
# Store prompt text in lineage (the hash is always stored)
RAGCOMPLIANCE_CAPTURE_PROMPTS=false
# Default actor for every record (per invocation actors override)
RAGCOMPLIANCE_ACTOR_ID=
RAGCOMPLIANCE_ACTOR_TYPE=service

# --- PII / PHI redaction ---
RAGCOMPLIANCE_REDACT_PII=false
# Comma separated subset of: anthropic_key,openai_key,bearer_token,aws_access_key,credit_card,ssn,email,phone_us,ipv4,iban
RAGCOMPLIANCE_REDACTION_PATTERNS=
RAGCOMPLIANCE_REDACTION_REPLACEMENT=[REDACTED:{name}]

# --- Supabase sink (optional) ---
# Project URL from https://app.supabase.com/project/<id>/settings/api
RAGCOMPLIANCE_SUPABASE_URL=
# Service role key (server-side only; it bypasses row level security)
RAGCOMPLIANCE_SUPABASE_KEY=
# Tenant key for this deployment; one hash chain per workspace
RAGCOMPLIANCE_WORKSPACE_ID=default
# Table name (defaults to rag_audit_logs)
RAGCOMPLIANCE_TABLE_NAME=rag_audit_logs
# 2 after running supabase_migration_v1.sql
RAGCOMPLIANCE_SUPABASE_SCHEMA_VERSION=1
# Flip off in prod if you ever want to short-circuit logging
RAGCOMPLIANCE_ENABLED=true
# Dev mode: in-memory sink plus stdout print when no sink is configured
RAGCOMPLIANCE_DEV_MODE=false
# Hard-block on quota exceeded (default soft-warn only)
RAGCOMPLIANCE_ENFORCE_QUOTA=false
# Fire-and-forget audit writes on a daemon worker (default true)
RAGCOMPLIANCE_ASYNC_WRITES=true
# Bounded in-memory buffer when Supabase is slow or unreachable
RAGCOMPLIANCE_ASYNC_MAX_QUEUE=1000
# Seconds to wait on process exit for the worker to drain
RAGCOMPLIANCE_ASYNC_SHUTDOWN_TIMEOUT=5.0

# --- Slack alerts (optional, opt-in) ---
# Incoming webhook URL; leave empty to disable alerting entirely
RAGCOMPLIANCE_SLACK_WEBHOOK_URL=
# Dashboard URL for "View in dashboard" link in alert payloads
RAGCOMPLIANCE_SLACK_DASHBOARD_URL=
# Alert when max chunk similarity falls below this threshold
RAGCOMPLIANCE_SLACK_MIN_SIMILARITY=0.3
# Alert when a chain takes longer than this many milliseconds end-to-end
RAGCOMPLIANCE_SLACK_SLOW_CHAIN_MS=10000
# Include the (redacted) query text in alert payloads (default: ids only)
RAGCOMPLIANCE_SLACK_INCLUDE_QUERY=false

# --- Dashboard (optional) ---
# Honour ?workspace_id= on read endpoints (turn SSO on first)
RAGCOMPLIANCE_DASHBOARD_ALLOW_ANY_WORKSPACE=false
# Comma separated CORS origins; blank disables CORS
RAGCOMPLIANCE_DASHBOARD_CORS_ORIGINS=

# --- OIDC SSO for the dashboard (optional) ---
# Leave all four unset to keep the dashboard open (useful for local dev).
# Set all four to turn SSO on via standards OIDC discovery.
RAGCOMPLIANCE_OIDC_ISSUER=
RAGCOMPLIANCE_OIDC_CLIENT_ID=
RAGCOMPLIANCE_OIDC_CLIENT_SECRET=
RAGCOMPLIANCE_OIDC_REDIRECT_URI=
# Comma-separated allowlist of email domains; leave blank to allow any.
RAGCOMPLIANCE_OIDC_ALLOWED_DOMAINS=
# 32+ char random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be set in prod so sessions survive restarts.
RAGCOMPLIANCE_SESSION_SECRET=

# --- Stripe (billing reference implementation, extra `billing`; inactive unless STRIPE_SECRET_KEY is set) ---
# Publishable key (safe to expose client-side)
STRIPE_PUBLISHABLE_KEY=
# Secret key (server-side only)
STRIPE_SECRET_KEY=
# Price IDs from https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID_TEAM=
STRIPE_PRICE_ID_ENTERPRISE=
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Public-facing base URL, used to build success/cancel URLs
APP_BASE_URL=http://localhost:8000
